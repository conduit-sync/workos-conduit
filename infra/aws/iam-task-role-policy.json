{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SSMCursorAccess",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/workos-conduit/*"
    },
    {
      "Sid": "S3StateListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::workos-conduit-state"
    },
    {
      "Sid": "S3StateObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::workos-conduit-state/*"
    }
  ]
}
