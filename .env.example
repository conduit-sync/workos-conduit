# ── WorkOS: Internal org (directory sync + dashboard operator SSO) ───
WORKOS_SSO_INTERNAL_ORG_API_KEY=sk_example_...
WORKOS_DIRECTORY_ID=directory_...
# WORKOS_EVENT_TYPES=["dsync.user.created","dsync.user.updated","dsync.user.deleted","dsync.group.user_added","dsync.group.user_removed"]
WORKOS_EVENTS_PAGE_SIZE=100
# SSO is enabled when WORKOS_SSO_INTERNAL_ORG_CLIENT_ID is set.
# WORKOS_SSO_INTERNAL_ORG_CLIENT_ID=client_...
# Per-realm public URL of this app (no trailing slash). Callbacks are derived automatically:
#   WorkOS SSO  → {base}/auth/callback
#   NinjaOne OAuth → {base}/dashboard/oauth/ninjaone/callback
# Reverse proxy sets X-Stakesmfg-Request-Realm: internal|eastlake
# DASHBOARD_PUBLIC_BASE_URL_INTERNAL=https://conduit-internal.example.com
# DASHBOARD_PUBLIC_BASE_URL_EASTLAKE=https://conduit-eastlake.example.com
# Local dev without a proxy (omit in production):
# REQUEST_REALM_DEFAULT=internal
# WORKOS_SSO_INTERNAL_ORG_ORGANIZATION_ID=org_...   # optional: restrict AuthKit login to one org
# Directory Sync role slugs (from WORKOS_DIRECTORY_ID) that control each menu:
# WORKOS_DASHBOARD_SYNC_BOARD_ROLE_SLUGS=app-workos-conduit-admin-role
# WORKOS_DASHBOARD_PORTAL_ROLE_SLUGS=app-workos-conduit-admin-role,app-workos-conduit-user-role
# WORKOS_SSO_INTERNAL_ORG_SESSION_SECRET=change-me-in-production

# ── WorkOS: Customer portal (separate org — invite end users) ───
# Required when Customer Portal Users page is used. API key falls back to
# WORKOS_SSO_INTERNAL_ORG_API_KEY only if both environments share the same project.
# WORKOS_CUSTOMER_PORTAL_API_KEY=sk_...
# WORKOS_CUSTOMER_PORTAL_ORGANIZATION_ID=org_...
# WORKOS_CUSTOMER_PORTAL_INVITE_ROLE_SLUG=app-customer-portal-user-role
# WORKOS_CUSTOMER_PORTAL_USER_CLIENT_ID_METADATA_KEY=client_id

# ── Active target adapter ─────────────────────────────
# Must match a registered adapter key in adapters/registry.py
# Current options: ninjaone
# Future options: zendesk, freshservice, jira_sm
SYNC_TARGET_ADAPTER=ninjaone

# Sync behaviour
SYNC_STOP_ON_ERROR=true          # if false, log error and continue (skips failed event)

# ── Backend selection ─────────────────────────────────
# CURSOR_BACKEND:
#   aws    → SSM cursor (production)
#   local  → file-based cursor in LOCAL_STATE_DIR/cursor.txt
#   memory → in-process only, cursor lost on restart (tests)
# STATE_BACKEND:
#   aws    → S3 run records (production)
#   local  → file-based run records in LOCAL_STATE_DIR/runs/
CURSOR_BACKEND=aws
STATE_BACKEND=aws
# LOCAL_STATE_DIR=.local-state   # directory for cursor.txt and runs/ when using local backends

# ── NinjaOne (used when SYNC_TARGET_ADAPTER=ninjaone) ─
NINJAONE_BASE_URL=https://app.ninjarmm.com
# OAuth app credentials
NINJAONE_OAUTH_CLIENT_ID=...
NINJAONE_OAUTH_CLIENT_SECRET=...
# Scope must include offline_access so NinjaOne issues a refresh token.
# control + monitoring + management cover device control and end-user CRUD.
NINJAONE_OAUTH_SCOPE=control offline_access monitoring management
# OAuth endpoints (override only for non-default NinjaOne regions)
# NINJAONE_OAUTH_AUTHORIZE_PATH=/oauth/authorize
# NINJAONE_OAUTH_TOKEN_PATH=/oauth/token
# Callback path mounted by this app (normally keep default; append to public base if building URLs manually)
# NINJAONE_OAUTH_REDIRECT_PATH=/dashboard/oauth/ninjaone/callback
# SSM SecureString that stores the long-lived refresh token payload JSON
NINJAONE_OAUTH_REFRESH_TOKEN_SSM_PARAM=/workos-conduit/ninjaone/oauth-refresh-token
# Optional: SSM parameter ARN mirrored when NinjaOne rotates the refresh token at runtime.
# Leave unset to skip; dashboard/CLI bootstrap always writes only to the param above.
# NINJAONE_OAUTH_REFRESH_TOKEN_UPDATE_SSM_ARN=arn:aws:ssm:us-east-1:123456789012:parameter/workos-conduit/ninjaone/oauth-refresh-token-active
# Used to compute estimated "expires in" in dashboard (NinjaOne does not return RT expiry)
# NINJAONE_OAUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
# JSON object with organizations_groups_mapping entries
NINJAONE_GROUP_ROLE_MAP={"organizations_groups_mapping":[{"ninjaone_organization_name":"Stakes Manufacturing","ninjaone_organization_id":"9e77507d-d092-4a37-bf99-c987fc27a327","google_workspace_group_name":"ninjaone-users","ninjaone_role":"END_USER"}]}
NINJAONE_GROUP_ROLE_MAP_SOURCE=env   # env | ssm
NINJAONE_GROUP_ROLE_MAP_SSM_PARAM=/workos-conduit/ninjaone/group-role-map

# ── HTTP client tuning (applies to outbound target calls) ──
HTTP_TIMEOUT_SECONDS=30
HTTP_RETRY_MAX_ATTEMPTS=3
HTTP_RETRY_BACKOFF_BASE_SECONDS=1.0

# ── AWS (used when CURSOR_BACKEND=aws or STATE_BACKEND=aws) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=          # required only for temporary/STS credentials
# AWS_PROFILE=                # optional; selects a named profile from ~/.aws/credentials
SSM_CURSOR_PARAM=/workos-conduit/cursor
S3_STATE_BUCKET=workos-conduit-state
S3_STATE_PREFIX=runs/

# ── FastAPI server ────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
API_SECRET_KEY=change-me-in-production

# ── Dashboard ─────────────────────────────────────────
DASHBOARD_ENABLED=true
DASHBOARD_RUN_HISTORY_LIMIT=50
DASHBOARD_AUTO_REFRESH_SECONDS=60

# ── Logging ───────────────────────────────────────────
LOG_LEVEL=INFO
LOG_OUTPUT=stdout                # stdout | file | both
LOG_FORMAT=json                  # json | console
LOG_FILE_PATH=/var/log/workos-conduit/app.log   # only used when LOG_OUTPUT != stdout
